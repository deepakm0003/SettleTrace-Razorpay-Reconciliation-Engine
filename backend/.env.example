# NVIDIA NIM API Keys
# Get your API keys from https://build.nvidia.com/

# You can use multiple keys for round-robin load balancing
# The system will cycle through them automatically

# Key 1 (required)
NVIDIA_API_KEY_1=nvapi-your-first-key-here
NVIDIA_MODEL_1=nvidia/nemotron-3-ultra-550b-a55b

# Key 2 (optional)
NVIDIA_API_KEY_2=nvapi-your-second-key-here
NVIDIA_MODEL_2=nvidia/nemotron-3-ultra-550b-a55b

# Key 3 (optional)
NVIDIA_API_KEY_3=nvapi-your-third-key-here
NVIDIA_MODEL_3=nvidia/nemotron-3-ultra-550b-a55b

# Key 4 (optional)
NVIDIA_API_KEY_4=nvapi-your-fourth-key-here
NVIDIA_MODEL_4=nvidia/nemotron-3-ultra-550b-a55b

# Key 5 (optional)
NVIDIA_API_KEY_5=nvapi-your-fifth-key-here
NVIDIA_MODEL_5=nvidia/nemotron-3-ultra-550b-a55b

# Key 6 (optional)
NVIDIA_API_KEY_6=nvapi-your-sixth-key-here
NVIDIA_MODEL_6=nvidia/nemotron-3-ultra-550b-a55b

# Key 7 (optional) - Can use DeepSeek as fallback
NVIDIA_API_KEY_7=nvapi-your-deepseek-key-here
NVIDIA_MODEL_7=deepseek-ai/deepseek-v4-flash-0731

# Alternative: Single key setup
# NVIDIA_API_KEY=nvapi-your-single-key-here

# Note: If no API keys are provided, the system will fall back to
# offline keyword-based classification with lower accuracy.
